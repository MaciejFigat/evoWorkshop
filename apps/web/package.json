{
  "name": "@evo/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=../../games/alchemy-brawl/tables --watch-path=../../games/alchemy-brawl/engine --disable-warning=ExperimentalWarning src/server/main.ts",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning src/server/main.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@evo/alchemy-brawl": "workspace:*",
    "@evo/game-sdk": "workspace:*",
    "@evo/protocol": "workspace:*",
    "@evo/rng": "workspace:*",
    "vite": "^8.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^5.0.1"
  }
}
